rules_version = '2';

// Storage: negar por padrao. Avatar e o unico upload de cliente no scaffold.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 5 * 1024 * 1024;
    }

    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && isImage();
    }

    // Midia de pilulas, anexos de briefing e gravacoes entram nas fases F8/F13.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
