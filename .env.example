# ---------------------------------------------------------------------------
# Firebase — cliente (expostas ao browser, sao publicas por natureza)
# Console > Configuracoes do projeto > Seus apps > Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Regiao das Cloud Functions (CLAUDE.md: southamerica-east1)
NEXT_PUBLIC_FUNCTIONS_REGION=southamerica-east1

# Usar emuladores locais (auth 9099, firestore 8080, functions 5001)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ---------------------------------------------------------------------------
# Firebase Admin — servidor. NUNCA prefixar com NEXT_PUBLIC_.
# Conteudo do JSON da service account em UMA linha (as quebras de linha da
# private_key ficam como \n literais).
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=

# Alternativa: caminho para o arquivo JSON (usado se FIREBASE_SERVICE_ACCOUNT
# estiver vazio). Em GCP/Vercel com WIF, deixe os dois vazios e o SDK usa as
# credenciais padrao do ambiente.
GOOGLE_APPLICATION_CREDENTIALS=

# Org padrao do marketplace aberto (invariante 9)
DEFAULT_ORG_ID=public
