# ---------------------------------------------------------------------------
# Copie para `.env.local` e preencha. `.env.local` nunca vai para o git.
#
# Invariante 17: Production usa o projeto `mentoria`;
#                Preview e Development usam `mentoria-dev`.
# Na Vercel, cadastre cada variável duas vezes — uma no escopo Production
# (apontando para `mentoria`) e outra em Preview + Development
# (apontando para `mentoria-dev`).
# ---------------------------------------------------------------------------

# --- Supabase: API (Settings > API) ---------------------------------------
# Vão para o navegador. Só o que é público mora aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# Chave anon (em projetos novos aparece como "publishable"). Respeita RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: service_role (Settings > API) ------------------------------
# Invariante 5: só no servidor. Ignora RLS. Nunca prefixar com NEXT_PUBLIC_.
# Em projetos novos aparece como "secret key".
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres: conexão do Drizzle (Settings > Database) -------------------
# Runtime na Vercel: use o *Transaction pooler* (porta 6543).
# `?pgbouncer=true` é o sinal para desligar prepared statements.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Migrations e drizzle-kit: conexão direta ou *Session pooler* (porta 5432).
# O pooler de transação não aceita DDL nem prepared statements.
DIRECT_URL=postgresql://postgres.SEU_PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
