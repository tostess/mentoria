# ---------------------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha. `.env.local` e ignorado pelo
# git e NUNCA deve ser versionado.
#
#   cp .env.local.example .env.local
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Firebase — cliente
# Sao expostas ao browser e publicas por natureza; nao sao segredo.
# Console > Configuracoes do projeto > Seus apps > Web > Configuracao do SDK
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin — servidor. NUNCA prefixar com NEXT_PUBLIC_.
# Vem do JSON da conta de servico (Console > Contas de servico > Gerar nova
# chave privada). Nao versione o arquivo JSON: copie os tres campos aqui.
#
# A private_key tem quebras de linha. Cole entre aspas, com os `\n` literais
# exatamente como aparecem no JSON — o codigo desescapa.
#   FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------

# Regiao das Cloud Functions (CLAUDE.md: southamerica-east1)
NEXT_PUBLIC_FUNCTIONS_REGION=southamerica-east1

# `true` aponta cliente e Admin SDK para os emuladores locais
# (auth 9099, firestore 8080, functions 5001, storage 9199).
NEXT_PUBLIC_USE_EMULATORS=false

# Org padrao do marketplace aberto (invariante 9)
DEFAULT_ORG_ID=public
