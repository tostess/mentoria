{
  "name": "mentoria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node -e \"process.env.DRIZZLE_ENV='production';require('child_process').execSync('npx drizzle-kit migrate',{stdio:'inherit'})\"",
    "db:check": "drizzle-kit check",
    "db:check:prod": "node -e \"process.env.DRIZZLE_ENV='production';require('child_process').execSync('npx drizzle-kit check',{stdio:'inherit'})\"",
    "db:studio": "drizzle-kit studio",
    "check:supabase": "node --env-file-if-exists=.env.local scripts/check-supabase.mts",
    "seed:admin": "node --env-file-if-exists=.env.local scripts/seed-admin.mts",
    "seed:admin:prod": "node --env-file=.env.production.local scripts/seed-admin.mts --producao"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.48.0",
    "luxon": "^3.7.2",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
