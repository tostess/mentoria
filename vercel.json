{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/cron/allocate-monthly",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/cron/expire-pending",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/close-sessions",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/anonymize-signups",
      "schedule": "30 6 * * *"
    }
  ]
}
